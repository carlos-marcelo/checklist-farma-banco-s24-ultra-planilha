# OAuth 2.0 Client ID do tipo "Aplicativo da Web".
# O Client ID é público; nunca adicione um Client Secret ao frontend.
VITE_GOOGLE_CLIENT_ID=

# Opcionais. Sem um ID fixo, o app localiza ou cria sua própria planilha.
VITE_GOOGLE_SPREADSHEET_ID=
VITE_GOOGLE_DRIVE_FOLDER_ID=
VITE_GOOGLE_SPREADSHEET_NAME=Checklist Farma - Dados

# Use / localmente. Ajuste apenas quando publicar em um subdiretório.
VITE_BASE_PATH=/
